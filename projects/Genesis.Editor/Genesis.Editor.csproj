    <PackageTags>genesis;editor;gnosis;gui;graphic;emergent;narrative</PackageTags>
    <RepositoryUrl>https://github.com/game-gpt/GenesisEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genesis\Genesis.csproj" />
    <ProjectReference Include="..\..\..\Gnosis.cs\projects\Gnosis.Graphic.GUI\Gnosis.Graphic.GUI.csproj" />
