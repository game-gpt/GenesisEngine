    <ProjectReference Include="..\..\..\Gnosis.cs\projects\Gnosis.Scene\Gnosis.Scene.csproj" />
    <ProjectReference Include="..\..\..\Gnosis.cs\projects\Gnosis.ECS\Gnosis.ECS.csproj" />
  </ItemGroup>

</Project>
