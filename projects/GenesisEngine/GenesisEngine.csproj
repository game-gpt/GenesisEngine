<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>GenesisHost</RootNamespace>
    <PackageId>GenesisHost</PackageId>
    <Version>0.0.0</Version>
    <Authors>Genesis Engine Team</Authors>
    <Description>Genesis Engine Host - Application hosting the Genesis game engine with Gnosis.Graphic rendering</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genesis\Genesis.csproj" />
    <ProjectReference Include="..\..\..\Gnosis.cs\projects\Gnosis.Graphic\Gnosis.Graphic.csproj" />
    <ProjectReference Include="..\..\..\Gnosis.cs\projects\Gnosis.Widget\Gnosis.Widget.csproj" />
  </ItemGroup>

</Project>
