system NoitaHUDSystem {
    query_player = Query.all(PlayerTag, PixelPosition, Health, ManaPool, Wand);
    query_daytime = Query.all(DayTime);

    on_update(delta: f32) {
        render_health_bar();
        render_mana_bar();
        render_wand_slots();
        render_spell_info();
        render_material_indicator();
        render_daytime_indicator();
        render_crosshair();
    }

    micro render_health_bar() {
        <% loop (_, _, health, _, _) in query_player { %>
            let bar_x = 20;
            let bar_y = screen.get_height() - 40;
            let bar_width = 200;
            let bar_height = 16;

            renderer.draw_rect(bar_x - 2, bar_y - 2, bar_width + 4, bar_height + 4, Vec3 { x: 0.0, y: 0.0, z: 0.0 });

            let bg_color = Vec3 { x: 0.25, y: 0.08, z: 0.08 };
            renderer.draw_rect(bar_x, bar_y, bar_width, bar_height, bg_color);

            let health_ratio = health.current as f32 / health.max as f32;
            let fill_width = (health_ratio * bar_width as f32) as i32;

            let hp_color = Vec3 { x: 0.75, y: 0.15, z: 0.15 };
            if health_ratio < 0.3 {
                hp_color = Vec3 { x: 0.9, y: 0.2, z: 0.1 };
                if sin(time.elapsed() * 6.0) > 0.0 {
                    hp_color = Vec3 { x: 1.0, y: 0.3, z: 0.15 };
                }
            }

            renderer.draw_rect(bar_x, bar_y, fill_width, bar_height, hp_color);

            renderer.draw_text(bar_x + 4, bar_y + 2,
                $"HP {health.current}/{health.max}",
                Vec3 { x: 1.0, y: 1.0, z: 1.0 });
        <% } %>
    }

    micro render_mana_bar() {
        <% loop (_, _, _, mana, _) in query_player { %>
            let bar_x = 20;
            let bar_y = screen.get_height() - 62;
            let bar_width = 200;
            let bar_height = 12;

            renderer.draw_rect(bar_x - 2, bar_y - 2, bar_width + 4, bar_height + 4, Vec3 { x: 0.0, y: 0.0, z: 0.0 });

            let bg_color = Vec3 { x: 0.08, y: 0.08, z: 0.25 };
            renderer.draw_rect(bar_x, bar_y, bar_width, bar_height, bg_color);

            let mana_ratio = mana.current / mana.max;
            let fill_width = (mana_ratio * bar_width as f32) as i32;

            let mana_color = Vec3 { x: 0.2, y: 0.4, z: 0.9 };
            if mana_ratio < 0.2 {
                mana_color = Vec3 { x: 0.3, y: 0.3, z: 0.6 };
            }

            renderer.draw_rect(bar_x, bar_y, fill_width, bar_height, mana_color);

            renderer.draw_text(bar_x + 4, bar_y,
                $"MP {mana.current:.0}/{mana.max:.0}",
                Vec3 { x: 0.8, y: 0.85, z: 1.0 });
        <% } %>
    }

    micro render_wand_slots() {
        <% loop (_, _, _, _, wand) in query_player { %>
            let slot_x = screen.get_width() / 2 - 80;
            let slot_y = screen.get_height() - 50;

            renderer.draw_rect(slot_x - 4, slot_y - 4, 168, 44, Vec3 { x: 0.0, y: 0.0, z: 0.0 });

            loop i in range(0, 6) {
                let x = slot_x + i * 28;
                let slot_color = Vec3 { x: 0.15, y: 0.12, z: 0.20 };
                if i == wand.current_slot as i32 {
                    slot_color = Vec3 { x: 0.35, y: 0.25, z: 0.55 };
                }
                renderer.draw_rect(x, slot_y, 24, 24, slot_color);

                if i < wand.spell_count as i32 {
                    let spell = get_spell_in_slot(wand, i);
                    if spell.spell_id != SPELL_NONE {
                        let spell_color = get_spell_color(spell.spell_id);
                        renderer.draw_rect(x + 4, slot_y + 4, 16, 16, spell_color);

                        if spell.charges > 0 {
                            renderer.draw_text(x + 14, slot_y + 16,
                                $"{spell.charges}",
                                Vec3 { x: 0.8, y: 0.8, z: 0.8 });
                        }
                    }
                }

                renderer.draw_text(x + 8, slot_y + 24,
                    $"{i + 1}",
                    Vec3 { x: 0.4, y: 0.4, z: 0.5 });
            }

            if wand.recharge_timer > 0.0 {
                let recharge_ratio = wand.recharge_timer / wand.recharge_time;
                let bar_width = 160;
                let fill = (recharge_ratio * bar_width as f32) as i32;
                renderer.draw_rect(slot_x, slot_y + 28, bar_width, 4, Vec3 { x: 0.2, y: 0.2, z: 0.2 });
                renderer.draw_rect(slot_x, slot_y + 28, fill, 4, Vec3 { x: 0.5, y: 0.3, z: 0.8 });
            }
        <% } %>
    }

    micro render_spell_info() {
        <% loop (_, _, _, _, wand) in query_player { %>
            let info_x = screen.get_width() / 2 - 80;
            let info_y = screen.get_height() - 72;

            if wand.current_slot < wand.spell_count {
                let spell = get_spell_in_slot(wand, wand.current_slot as i32);
                if spell.spell_id != SPELL_NONE {
                    renderer.draw_rect(info_x, info_y, 168, 18, Vec3 { x: 0.0, y: 0.0, z: 0.0 });
                    let spell_name = get_spell_name(spell.spell_id);
                    let mana_cost = get_spell_mana_cost(spell.spell_id);
                    renderer.draw_text(info_x + 4, info_y + 2,
                        $"{spell_name} (消耗: {mana_cost:.0})",
                        Vec3 { x: 0.9, y: 0.85, z: 1.0 });
                }
            }
        <% } %>
    }

    micro render_material_indicator() {
        <% loop (_, pos, _, _, _) in query_player { %>
            let target_x = pos.x + get_facing_offset_x();
            let target_y = pos.y + get_facing_offset_y();

            let material_id = pixel_grid.get_material(target_x, target_y);
            if material_id != MATERIAL_NONE && material_id != MATERIAL_BOUNDARY {
                let indicator_x = screen.get_width() / 2 - 60;
                let indicator_y = screen.get_height() / 2 + 30;

                renderer.draw_rect(indicator_x, indicator_y, 120, 18, Vec3 { x: 0.0, y: 0.0, z: 0.0 });
                let name = get_material_name(material_id);
                let color = get_material_color(material_id);
                renderer.draw_rect(indicator_x + 4, indicator_y + 4, 10, 10, color);
                renderer.draw_text(indicator_x + 18, indicator_y + 2,
                    name,
                    Vec3 { x: 0.9, y: 0.9, z: 0.9 });
            }
        <% } %>
    }

    micro render_daytime_indicator() {
        <% loop (daytime,) in query_daytime { %>
            let indicator_x = screen.get_width() - 80;
            let indicator_y = 10;

            let is_night = daytime.time_of_day < 0.25 || daytime.time_of_day >= 0.75;

            if is_night {
                let moon_color = Vec3 { x: 0.8, y: 0.85, z: 0.95 };
                renderer.draw_rect(indicator_x + 20, indicator_y + 4, 14, 14, moon_color);
            }
            else {
                let sun_color = Vec3 { x: 1.0, y: 0.95, z: 0.5 };
                renderer.draw_rect(indicator_x + 20, indicator_y + 4, 14, 14, sun_color);
            }

            renderer.draw_text(indicator_x, indicator_y,
                $"第{daytime.day_count}天",
                Vec3 { x: 0.8, y: 0.8, z: 0.8 });
        <% } %>
    }

    micro render_crosshair() {
        let cx = screen.get_width() / 2;
        let cy = screen.get_height() / 2;
        let color = Vec3 { x: 0.9, y: 0.9, z: 0.9 };

        renderer.draw_line(cx - 6, cy, cx - 2, cy, color);
        renderer.draw_line(cx + 2, cy, cx + 6, cy, color);
        renderer.draw_line(cx, cy - 6, cx, cy - 2, color);
        renderer.draw_line(cx, cy + 2, cx, cy + 6, color);
    }

    micro get_spell_color(spell_id: i32) -> Vec3 {
        if spell_id == SPELL_SPARK_BOLT { return Vec3 { x: 1.0, y: 0.6, z: 0.1 }; }
        if spell_id == SPELL_BOMB { return Vec3 { x: 0.6, y: 0.3, z: 0.1 }; }
        if spell_id == SPELL_WATER_SPRAY { return Vec3 { x: 0.2, y: 0.5, z: 1.0 }; }
        if spell_id == SPELL_TELEPORT { return Vec3 { x: 0.6, y: 0.2, z: 0.9 }; }
        return Vec3 { x: 0.5, y: 0.5, z: 0.5 };
    }

    micro get_spell_in_slot(wand: Wand, slot: i32) -> Spell {
        let spells = Query.all(Spell);
        let idx = 0;
        <% loop (spell,) in spells { %>
            if idx == slot {
                return spell;
            }
            idx += 1;
        <% } %>
        return Spell { spell_id: SPELL_NONE, mana_cost: 0.0, cooldown: 0.0, charges: 0, damage: 0.0, speed: 0.0, lifetime: 0.0, radius: 0.0, spell_type: 0, element: 0, bounces: 0, piercing: false };
    }
}
