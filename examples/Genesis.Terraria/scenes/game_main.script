scene GameMain {
    let player: Entity;
    let world_seed: u64;
    let daytime_entity: Entity;

    on_load() {
        let config = asset.load<gonObject>("config/world.gon");
        world_seed = config.get("seed").as_u64();

        daytime_entity = create_entity();
        daytime_entity.add(DayTime { time_of_day: 0.25, day_duration: 600.0, day_count: 1 });

        generate_world(world_seed);
    }

    on_update(delta: f32) {
        handle_input(delta);
        update_camera();
    }

    micro generate_world(seed: u64) {
        let biome_count = 8;
        let chunk_size = 200;
        loop i in range(0, biome_count) {
            let region = create_entity();
            region.add(BiomeTag { biome_id: i, corruption_level: 0.0, hallow_level: 0.0 });
            region.add(TilePosition { x: i * chunk_size, y: 0 });
        }
    }

    micro handle_input(delta: f32) {
        let pos = player.get<TilePosition>();
        let vel = player.get<Velocity>();
        vel.vx = 0.0;
    }

    micro update_camera() {
        let pos = player.get<TilePosition>();
        let camera_follow = player.get<CameraFollow>();
    }
}
