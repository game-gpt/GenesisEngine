scene GameMain {
    let player: Entity;
    let world_seed: u64;
    let stats_entity: Entity;
    let power_network_entity: Entity;
    let camera_x: f32 = 0.0;
    let camera_y: f32 = 0.0;
    let show_help: bool = true;
    let help_timer: f32 = 0.0;

    on_load() {
        let config = asset.load<gonObject>("config/world.gon");
        world_seed = config.get("seed").as_u64();

        console::log("=== Factorio Demo ===");
        console::log("WASD: 移动 | R: 旋转朝向 | 鼠标左键: 放置建筑/采矿");
        console::log("E: 设置配方 | Q: 设置请求 | F: 连接电力");
        console::log("B: 复制蓝图 | V: 粘贴蓝图 | N: 旋转蓝图");
        console::log("1-9/0: 选择快捷栏");
        console::log($"Factorio 世界初始化 - 种子: {world_seed}");
    }

    on_update(delta: f32) {
        update_stats(delta);
        handle_input(delta);
        update_camera(delta);
        update_help_timer(delta);
    }

    micro update_stats(delta: f32) {
        if stats_entity.is_valid {
            let stats = stats_entity.get<WorldStats>();
            stats.play_time += delta;

            if power_network_entity.is_valid {
                let network = power_network_entity.get<PowerNetwork>();
                stats.total_power_production = network.total_production;
                stats.total_power_consumption = network.total_consumption;
            }
        }
    }

    micro handle_input(delta: f32) {
        if !player.is_valid {
            return;
        }

        let pos = player.get<GridPosition>();

        update_facing_from_movement();

        if input.is_action_just_pressed("set_recipe") {
            let target_x = pos.x + get_facing_offset_x();
            let target_y = pos.y + get_facing_offset_y();
            let machine = find_machine_at(target_x, target_y);
            if machine.machine_type >= 0 {
                cycle_recipe(machine);
            }
        }

        if input.is_action_just_pressed("set_request") {
            let target_x = pos.x + get_facing_offset_x();
            let target_y = pos.y + get_facing_offset_y();
            let chest = find_chest_at(target_x, target_y);
            if chest.chest_type == CHEST_REQUESTER {
                cycle_request(chest);
            }
        }

        if input.is_action_just_pressed("connect_power") {
            let target_x = pos.x + get_facing_offset_x();
            let target_y = pos.y + get_facing_offset_y();
            connect_to_power_network(target_x, target_y);
        }

        if input.is_action_just_pressed("toggle_help") {
            show_help = !show_help;
        }

        if input.is_action_just_pressed("pick_up_building") {
            try_pick_up_building(pos);
        }
    }

    micro update_facing_from_movement() {
        let dx = 0.0;
        let dy = 0.0;
        if input.is_action_pressed("move_up") { dy = -1.0; }
        if input.is_action_pressed("move_down") { dy = 1.0; }
        if input.is_action_pressed("move_left") { dx = -1.0; }
        if input.is_action_pressed("move_right") { dx = 1.0; }

        if dx != 0.0 || dy != 0.0 {
            if abs(dx) > abs(dy) {
                if dx > 0 { facing_direction = DIR_EAST; }
                else { facing_direction = DIR_WEST; }
            }
            else {
                if dy > 0 { facing_direction = DIR_SOUTH; }
                else { facing_direction = DIR_NORTH; }
            }
        }
    }

    micro cycle_recipe(machine: Machine) {
        let recipes = asset.load<gonArray>("config/recipes.gon");
        let category = "crafting";
        if machine.machine_type == MACHINE_FURNACE {
            category = "smelting";
        }

        let current_idx = -1;
        let valid_recipes: [i32] = [];

        loop i in range(0, recipes.length()) {
            let recipe = recipes.get(i);
            if recipe.get("category").as_string() == category {
                valid_recipes.push(i);
                if machine.recipe_id == i {
                    current_idx = valid_recipes.length() - 1;
                }
            }
        }

        if valid_recipes.length() == 0 {
            return;
        }

        let next_idx = (current_idx + 1) % valid_recipes.length();
        machine.recipe_id = valid_recipes.get(next_idx);

        let recipe_name = recipes.get(machine.recipe_id).get("name").as_string();
        console::log($"配方已设置：{recipe_name}");
    }

    micro cycle_request(chest: LogisticChest) {
        let items = asset.load<gonArray>("config/items.gon");
        let current_idx = -1;
        let valid_items: [i32] = [];

        loop i in range(0, items.length()) {
            let item = items.get(i);
            if item.get("type").as_string() == "intermediate" || item.get("type").as_string() == "resource" {
                let item_id = item.get("id").as_int();
                valid_items.push(item_id);
                if chest.request_id == item_id {
                    current_idx = valid_items.length() - 1;
                }
            }
        }

        if valid_items.length() == 0 {
            return;
        }

        let next_idx = (current_idx + 1) % valid_items.length();
        chest.request_id = valid_items.get(next_idx);
        chest.request_count = 10;

        console::log($"请求物品已设置：{get_item_name(chest.request_id)} x{chest.request_count}");
    }

    micro connect_to_power_network(x: i32, y: i32) {
        let entity = find_entity_at(x, y);
        if !entity.is_valid {
            return;
        }

        if entity.has<Power>() {
            let power = entity.get<Power>();
            power.network_id = 0;
            console::log($"已连接到电力网络：({x}, {y})");
        }

        if entity.has<PowerPole>() {
            let pole = entity.get<PowerPole>();
            pole.network_id = 0;
            console::log($"电线杆已连接：({x}, {y})");
        }
    }

    micro try_pick_up_building(pos: GridPosition) {
        let target_x = pos.x + get_facing_offset_x();
        let target_y = pos.y + get_facing_offset_y();

        let belt = find_belt_at(target_x, target_y);
        if belt.speed > 0.0 {
            let inventory = player.get<Inventory>();
            add_item_to_inventory(inventory, ITEM_TRANSPORT_BELT, 1);
            let entity = find_entity_at(target_x, target_y);
            if entity.is_valid {
                destroy_entity(entity);
                console::log("已拾取传送带");
            }
            return;
        }

        let machine = find_machine_at(target_x, target_y);
        if machine.machine_type >= 0 {
            let inventory = player.get<Inventory>();
            let item_id = machine_type_to_item(machine.machine_type);
            if item_id != ITEM_NONE {
                add_item_to_inventory(inventory, item_id, 1);
                let entity = find_entity_at(target_x, target_y);
                if entity.is_valid {
                    destroy_entity(entity);
                    console::log($"已拾取{get_item_name(item_id)}");
                }
            }
            return;
        }

        let chest = find_chest_at(target_x, target_y);
        if chest.chest_type >= 0 {
            let inventory = player.get<Inventory>();
            let item_id = chest_type_to_item(chest.chest_type);
            if item_id != ITEM_NONE {
                add_item_to_inventory(inventory, item_id, 1);
                let entity = find_entity_at(target_x, target_y);
                if entity.is_valid {
                    destroy_entity(entity);
                    console::log($"已拾取{get_item_name(item_id)}");
                }
            }
            return;
        }
    }

    micro machine_type_to_item(machine_type: i32) -> i32 {
        if machine_type == MACHINE_FURNACE { return ITEM_FURNACE; }
        if machine_type == MACHINE_ASSEMBLER { return ITEM_ASSEMBLING_MACHINE; }
        if machine_type == MACHINE_BOILER { return ITEM_BOILER; }
        if machine_type == MACHINE_STEAM_ENGINE { return ITEM_STEAM_ENGINE; }
        return ITEM_NONE;
    }

    micro chest_type_to_item(chest_type: i32) -> i32 {
        if chest_type == CHEST_PROVIDER { return ITEM_PROVIDER_CHEST; }
        if chest_type == CHEST_REQUESTER { return ITEM_REQUESTER_CHEST; }
        return ITEM_NONE;
    }

    micro update_camera(delta: f32) {
        if !player.is_valid {
            return;
        }

        let pos = player.get<GridPosition>();
        let camera_follow = player.get<CameraFollow>();

        let target_x = pos.x as f32 + camera_follow.offset_x;
        let target_y = pos.y as f32 + camera_follow.offset_y;

        camera_x += (target_x - camera_x) * camera_follow.smoothing;
        camera_y += (target_y - camera_y) * camera_follow.smoothing;

        camera.set_position_2d(camera_x, camera_y);
    }

    micro update_help_timer(delta: f32) {
        if show_help {
            help_timer += delta;
            if help_timer > 30.0 {
                show_help = false;
            }
        }
    }
}
