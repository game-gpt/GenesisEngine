struct RecipeResult {
    is_valid: bool;
    result_item: i32;
    result_count: i32;
}

struct RaycastHit {
    is_valid: bool;
    x: i32;
    y: i32;
    z: i32;
}

let loaded_chunks: [Vec2] = [];

micro is_chunk_loaded(cx: i32, cz: i32) -> bool {
    loop i in range(0, loaded_chunks.length()) {
        let chunk = loaded_chunks.get(i);
        if chunk.x == cx && chunk.y == cz {
            return true;
        }
    }
    return false;
}

micro mark_chunk_loaded(cx: i32, cz: i32) {
    loaded_chunks.push(Vec2 { x: cx, y: cz });
}

micro generate_chunk(cx: i32, cz: i32) {
    let config = asset.load<gonObject>("config/world.gon");
    let seed = config.get("seed").as_u64();
    let chunk_width = config.get("world_size").get("chunk_width").as_int();
    let chunk_height = config.get("world_size").get("chunk_height").as_int();
    let chunk_depth = config.get("world_size").get("chunk_depth").as_int();
    let sea_level = config.get("generation").get("sea_level").as_int();

    let chunk_entity = create_entity();
    chunk_entity.add(ChunkData { chunk_x: cx, chunk_z: cz, seed: seed });

    generate_chunk_terrain(seed, cx, cz, chunk_width, chunk_height, chunk_depth, sea_level);
    mark_chunk_loaded(cx, cz);
}

micro raycast_block(player_pos: BlockPosition, max_distance: f32) -> RaycastHit {
    let aim_x = input.get_aim_x();
    let aim_y = input.get_aim_y();

    let dir_x = aim_x;
    let dir_y = aim_y;
    let dir_z = sqrt(1.0 - aim_x * aim_x - aim_y * aim_y);

    let step_x = 0;
    let step_y = 0;
    let step_z = 0;
    if dir_x > 0.1 { step_x = 1; }
    else if dir_x < -0.1 { step_x = -1; }
    if dir_y > 0.1 { step_y = 1; }
    else if dir_y < -0.1 { step_y = -1; }
    if dir_z > 0.1 { step_z = -1; }
    else if dir_z < -0.1 { step_z = 1; }

    if step_x == 0 && step_y == 0 && step_z == 0 {
        step_z = -1;
    }

    let check_x = player_pos.x;
    let check_y = player_pos.y;
    let check_z = player_pos.z;

    loop i in range(0, 6) {
        check_x += step_x;
        check_y += step_y;
        check_z += step_z;

        if world.is_solid(check_x, check_y, check_z) {
            return RaycastHit { is_valid: true, x: check_x, y: check_y, z: check_z };
        }
    }

    return RaycastHit { is_valid: false, x: 0, y: 0, z: 0 };
}

micro item_to_block(item_id: i32) -> i32 {
    if item_id == ITEM_WOOD { return BLOCK_WOOD; }
    if item_id == ITEM_WOOD_PLANKS { return BLOCK_WOOD; }
    if item_id == ITEM_STONE { return BLOCK_STONE; }
    if item_id == ITEM_COBBLESTONE { return BLOCK_STONE; }
    if item_id == ITEM_SAND { return BLOCK_SAND; }
    if item_id == ITEM_DIRT { return BLOCK_DIRT; }
    return BLOCK_AIR;
}

micro block_to_item(block_id: i32) -> i32 {
    if block_id == BLOCK_STONE { return ITEM_COBBLESTONE; }
    if block_id == BLOCK_DIRT { return ITEM_DIRT; }
    if block_id == BLOCK_GRASS { return ITEM_DIRT; }
    if block_id == BLOCK_SAND { return ITEM_SAND; }
    if block_id == BLOCK_WOOD { return ITEM_WOOD; }
    if block_id == BLOCK_LEAF { return ITEM_NONE; }
    if block_id == BLOCK_COAL_ORE { return ITEM_COAL; }
    if block_id == BLOCK_IRON_ORE { return ITEM_IRON_ORE; }
    if block_id == BLOCK_GOLD_ORE { return ITEM_GOLD_ORE; }
    if block_id == BLOCK_DIAMOND_ORE { return ITEM_DIAMOND; }
    if block_id == BLOCK_SNOW { return ITEM_SNOW; }
    if block_id == BLOCK_ICE { return ITEM_ICE; }
    return ITEM_NONE;
}

micro add_item_to_inventory(item_id: i32, count: i32) {
    let query = Query.all(PlayerTag, Inventory);
    <% loop (_, inventory) in query { %>
        let remaining = count;

        loop i in range(0, inventory.slots) {
            if inventory.item_ids[i] == item_id && inventory.item_counts[i] > 0 {
                let can_add = 64 - inventory.item_counts[i];
                if can_add > 0 {
                    let add = min(can_add, remaining);
                    inventory.item_counts[i] += add;
                    remaining -= add;
                    if remaining == 0 {
                        return;
                    }
                }
            }
        }

        loop i in range(0, inventory.slots) {
            if inventory.item_ids[i] == ITEM_NONE || inventory.item_counts[i] == 0 {
                inventory.item_ids[i] = item_id;
                let add = min(64, remaining);
                inventory.item_counts[i] = add;
                remaining -= add;
                if remaining == 0 {
                    return;
                }
            }
        }
    <% } %>
}

micro remove_item_from_slot(inventory: Inventory, slot: i32, count: i32) {
    if slot < 0 || slot >= inventory.slots {
        return;
    }
    inventory.item_counts[slot] -= count;
    if inventory.item_counts[slot] <= 0 {
        inventory.item_ids[slot] = ITEM_NONE;
        inventory.item_counts[slot] = 0;
    }
}

micro get_mob_name(mob_type: i32) -> string {
    if mob_type == MOB_ZOMBIE { return "僵尸"; }
    if mob_type == MOB_SKELETON { return "骷髅"; }
    if mob_type == MOB_CREEPER { return "爬行者"; }
    return "未知怪物";
}

micro get_mob_max_health(mob_type: i32) -> i32 {
    if mob_type == MOB_ZOMBIE { return 20; }
    if mob_type == MOB_SKELETON { return 20; }
    if mob_type == MOB_CREEPER { return 20; }
    return 10;
}

micro get_mob_attack_damage(mob_type: i32) -> i32 {
    if mob_type == MOB_ZOMBIE { return 3; }
    if mob_type == MOB_SKELETON { return 2; }
    if mob_type == MOB_CREEPER { return 6; }
    return 1;
}

micro get_daytime() -> f32 {
    let query = Query.all(DayTime);
    <% loop (daytime,) in query { %>
        return daytime.time_of_day;
    <% } %>
    return 0.5;
}

micro get_food_value(item_id: i32) -> i32 {
    if item_id == ITEM_ROTTEN_FLESH { return 4; }
    return 0;
}

