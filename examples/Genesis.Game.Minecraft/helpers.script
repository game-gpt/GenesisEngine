    if biome_id == BIOME_FOREST { return "森林"; }
    if biome_id == BIOME_TAIGA { return "针叶林"; }
    if biome_id == BIOME_MOUNTAINS { return "山脉"; }
    if biome_id == BIOME_OCEAN { return "海洋"; }
    return "未知";
}

micro get_block_color(block_id: i32) -> Vec3 {
    let blocks = asset.load<gonArray>("config/block_colors.gon");
    let block_list = blocks.get("blocks");
    loop i in range(0, block_list.length()) {
        let block = block_list.get(i);
        if block.get("id").as_int() == block_id {
            return Vec3 {
                x: block.get("r").as_f32(),
                y: block.get("g").as_f32(),
                z: block.get("b").as_f32()
            };
        }
    }
    return Vec3 { x: 1.0, y: 0.0, z: 1.0 };
}
