system TerrariaHUDSystem {
    query_player = Query.all(PlayerTag, Health, Inventory);
    query_daytime = Query.all(DayTime);
    query_biome = Query.all(BiomeTag, TilePosition);

    on_update(delta: f32) {
        render_hotbar();
        render_health_hearts();
        render_daytime_indicator();
        render_biome_indicator();
        render_cursor_item();
    }

    micro render_hotbar() {
        <% loop (_, _, inventory) in query_player { %>
            let bar_x = screen.get_width() / 2 - 90;
            let bar_y = screen.get_height() - 44;

            renderer.draw_rect(bar_x - 2, bar_y - 2, 184, 40, Vec3 { x: 0.0, y: 0.0, z: 0.0 });

            loop i in range(0, 10) {
                let slot_x = bar_x + i * 18;
                let slot_color = Vec3 { x: 0.15, y: 0.15, z: 0.18 };
                if i == inventory.selected_slot {
                    slot_color = Vec3 { x: 0.35, y: 0.35, z: 0.45 };
                }
                renderer.draw_rect(slot_x, bar_y, 16, 16, slot_color);

                if i < inventory.slots && inventory.item_ids[i] != ITEM_NONE {
                    let item_color = get_item_display_color(inventory.item_ids[i]);
                    renderer.draw_rect(slot_x + 2, bar_y + 2, 12, 12, item_color);

                    if inventory.item_counts[i] > 1 {
                        renderer.draw_text(slot_x + 8, bar_y + 10,
                            $"{inventory.item_counts[i]}",
                            Vec3 { x: 1.0, y: 1.0, z: 1.0 });
                    }
                }
            }
        <% } %>
    }

    micro render_health_hearts() {
        <% loop (_, health, _) in query_player { %>
            let bar_x = screen.get_width() / 2 - 90;
            let bar_y = screen.get_height() - 62;

            let hearts = health.max / 20;
            loop i in range(0, hearts) {
                let heart_x = bar_x + i * 18;
                let empty_color = Vec3 { x: 0.25, y: 0.08, z: 0.08 };
                renderer.draw_rect(heart_x, bar_y, 14, 14, empty_color);

                let hp_at_heart = health.current - i * 20;
                if hp_at_heart > 0 {
                    let fill_color = Vec3 { x: 0.80, y: 0.12, z: 0.12 };
                    if health.current <= 20 {
                        fill_color = Vec3 { x: 0.9, y: 0.3, z: 0.1 };
                        if sin(time.elapsed() * 8.0) > 0.0 {
                            fill_color = Vec3 { x: 1.0, y: 0.4, z: 0.15 };
                        }
                    }

                    let fill_ratio = min(1.0, hp_at_heart as f32 / 20.0);
                    let fill_height = (fill_ratio * 10) as i32;
                    renderer.draw_rect(heart_x + 2, bar_y + 12 - fill_height, 10, fill_height, fill_color);
                }

                renderer.draw_rect_outline(heart_x, bar_y, 14, 14, Vec3 { x: 0.4, y: 0.15, z: 0.15 });
            }
        <% } %>
    }

    micro render_daytime_indicator() {
        <% loop (daytime,) in query_daytime { %>
            let indicator_x = screen.get_width() - 70;
            let indicator_y = 10;

            let is_day = daytime.time_of_day >= 0.25 && daytime.time_of_day < 0.75;

            if is_day {
                let sun_color = Vec3 { x: 1.0, y: 0.95, z: 0.5 };
                renderer.draw_rect(indicator_x + 10, indicator_y + 4, 12, 12, sun_color);
            }
            else {
                let moon_color = Vec3 { x: 0.8, y: 0.85, z: 0.95 };
                renderer.draw_rect(indicator_x + 10, indicator_y + 4, 12, 12, moon_color);
            }

            renderer.draw_text(indicator_x, indicator_y,
                $"第{daytime.day_count}天",
                Vec3 { x: 0.9, y: 0.9, z: 0.9 });
        <% } %>
    }

    micro render_biome_indicator() {
        <% loop (biome, pos) in query_biome { %>
            <% loop (_, player_pos) in Query.all(PlayerTag, TilePosition) { %>
                if abs(player_pos.x - pos.x) < 100 {
                    let indicator_x = 10;
                    let indicator_y = screen.get_height() - 80;

                    let biome_name = get_biome_name(biome.biome_id);
                    let biome_color = get_biome_display_color(biome.biome_id);

                    renderer.draw_rect(indicator_x, indicator_y, 120, 18, Vec3 { x: 0.0, y: 0.0, z: 0.0 });
                    renderer.draw_rect(indicator_x, indicator_y, 4, 18, biome_color);
                    renderer.draw_text(indicator_x + 8, indicator_y + 2,
                        biome_name,
                        Vec3 { x: 0.9, y: 0.9, z: 0.9 });
                }
            <% } %>
        <% } %>
    }

    micro render_cursor_item() {
        <% loop (_, _, inventory) in query_player { %>
            let held_item = inventory.item_ids[inventory.selected_slot];
            if held_item != ITEM_NONE {
                let info_x = screen.get_width() / 2 - 50;
                let info_y = screen.get_height() - 82;

                let item_name = get_item_name(held_item);
                renderer.draw_rect(info_x, info_y, 100, 16, Vec3 { x: 0.0, y: 0.0, z: 0.0 });
                renderer.draw_text(info_x + 4, info_y + 2,
                    item_name,
                    Vec3 { x: 1.0, y: 1.0, z: 1.0 });
            }
        <% } %>
    }

    micro get_item_display_color(item_id: i32) -> Vec3 {
        if item_id == ITEM_DIRT { return Vec3 { x: 0.55, y: 0.35, z: 0.20 }; }
        if item_id == ITEM_STONE { return Vec3 { x: 0.55, y: 0.55, z: 0.55 }; }
        if item_id == ITEM_WOOD { return Vec3 { x: 0.55, y: 0.35, z: 0.15 }; }
        if item_id == ITEM_SAND { return Vec3 { x: 0.80, y: 0.75, z: 0.50 }; }
        if item_id == ITEM_IRON_ORE { return Vec3 { x: 0.60, y: 0.55, z: 0.50 }; }
        if item_id == ITEM_GOLD_ORE { return Vec3 { x: 0.70, y: 0.60, z: 0.20 }; }
        if item_id == ITEM_COPPER_ORE { return Vec3 { x: 0.72, y: 0.45, z: 0.20 }; }
        if item_id == ITEM_COPPER_BAR { return Vec3 { x: 0.72, y: 0.45, z: 0.20 }; }
        if item_id == ITEM_IRON_BAR { return Vec3 { x: 0.70, y: 0.70, z: 0.75 }; }
        if item_id == ITEM_GOLD_BAR { return Vec3 { x: 0.90, y: 0.75, z: 0.20 }; }
        if item_id == ITEM_WOODEN_SWORD { return Vec3 { x: 0.60, y: 0.45, z: 0.20 }; }
        if item_id == ITEM_WOODEN_PICKAXE { return Vec3 { x: 0.60, y: 0.45, z: 0.20 }; }
        if item_id == ITEM_COPPER_SWORD { return Vec3 { x: 0.72, y: 0.45, z: 0.20 }; }
        if item_id == ITEM_COPPER_PICKAXE { return Vec3 { x: 0.72, y: 0.45, z: 0.20 }; }
        if item_id == ITEM_IRON_SWORD { return Vec3 { x: 0.70, y: 0.70, z: 0.75 }; }
        if item_id == ITEM_IRON_PICKAXE { return Vec3 { x: 0.70, y: 0.70, z: 0.75 }; }
        if item_id == ITEM_GEL { return Vec3 { x: 0.30, y: 0.70, z: 0.40 }; }
        if item_id == ITEM_TORCH { return Vec3 { x: 0.90, y: 0.70, z: 0.20 }; }
        if item_id == ITEM_HEALING_POTION { return Vec3 { x: 0.90, y: 0.20, z: 0.30 }; }
        return Vec3 { x: 0.5, y: 0.5, z: 0.5 };
    }

    micro get_biome_display_color(biome_id: i32) -> Vec3 {
        if biome_id == BIOME_FOREST { return Vec3 { x: 0.30, y: 0.55, z: 0.20 }; }
        if biome_id == BIOME_DESERT { return Vec3 { x: 0.80, y: 0.70, z: 0.35 }; }
        if biome_id == BIOME_CORRUPTION { return Vec3 { x: 0.30, y: 0.15, z: 0.50 }; }
        if biome_id == BIOME_CRIMSON { return Vec3 { x: 0.70, y: 0.10, z: 0.15 }; }
        if biome_id == BIOME_HALLOW { return Vec3 { x: 0.60, y: 0.30, z: 0.70 }; }
        if biome_id == BIOME_JUNGLE { return Vec3 { x: 0.15, y: 0.50, z: 0.15 }; }
        if biome_id == BIOME_TUNDRA { return Vec3 { x: 0.70, y: 0.80, z: 0.90 }; }
        if biome_id == BIOME_OCEAN { return Vec3 { x: 0.15, y: 0.35, z: 0.70 }; }
        return Vec3 { x: 0.5, y: 0.5, z: 0.5 };
    }
}
