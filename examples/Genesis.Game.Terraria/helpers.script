struct Vec2 {
    x: i32;
    y: i32;
}

micro tile_to_item(tile_id: i32) -> i32 {
    if tile_id == TILE_DIRT { return ITEM_DIRT; }
    if tile_id == TILE_STONE { return ITEM_STONE; }
    if tile_id == TILE_GRASS { return ITEM_DIRT; }
    if tile_id == TILE_SAND { return ITEM_SAND; }
    if tile_id == TILE_WOOD { return ITEM_WOOD; }
    if tile_id == TILE_IRON_ORE { return ITEM_IRON_ORE; }
    if tile_id == TILE_GOLD_ORE { return ITEM_GOLD_ORE; }
    if tile_id == TILE_COPPER_ORE { return ITEM_COPPER_ORE; }
    if tile_id == TILE_SNOW { return ITEM_SNOW; }
    if tile_id == TILE_CLAY { return ITEM_CLAY; }
    return ITEM_NONE;
}

micro item_to_tile(item_id: i32) -> i32 {
    if item_id == ITEM_DIRT { return TILE_DIRT; }
    if item_id == ITEM_STONE { return TILE_STONE; }
    if item_id == ITEM_WOOD { return TILE_WOOD; }
    if item_id == ITEM_SAND { return TILE_SAND; }
    return TILE_AIR;
}

micro get_tile_name(tile_id: i32) -> string {
    if tile_id == TILE_AIR { return "空气"; }
    if tile_id == TILE_DIRT { return "泥土"; }
    if tile_id == TILE_STONE { return "石头"; }
    if tile_id == TILE_GRASS { return "草地"; }
    if tile_id == TILE_SAND { return "沙子"; }
    if tile_id == TILE_WATER { return "水"; }
    if tile_id == TILE_WOOD { return "木头"; }
    if tile_id == TILE_LEAF { return "树叶"; }
    if tile_id == TILE_IRON_ORE { return "铁矿"; }
    if tile_id == TILE_GOLD_ORE { return "金矿"; }
    if tile_id == TILE_COPPER_ORE { return "铜矿"; }
    if tile_id == TILE_SNOW { return "雪"; }
    if tile_id == TILE_ICE { return "冰"; }
    if tile_id == TILE_CLAY { return "粘土"; }
    if tile_id == TILE_BOUNDARY { return "边界"; }
    return "未知";
}

