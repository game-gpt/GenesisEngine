    if biome_id == BIOME_FOREST { return "森林"; }
    if biome_id == BIOME_DESERT { return "沙漠"; }
    if biome_id == BIOME_CORRUPTION { return "腐蚀之地"; }
    if biome_id == BIOME_CRIMSON { return "猩红之地"; }
    if biome_id == BIOME_HALLOW { return "神圣之地"; }
    if biome_id == BIOME_JUNGLE { return "丛林"; }
    if biome_id == BIOME_TUNDRA { return "冻原"; }
    if biome_id == BIOME_OCEAN { return "海洋"; }
    return "未知";
}

micro get_npc_name(npc_type: i32) -> string {
    if npc_type == NPC_MERCHANT { return "商人"; }
    if npc_type == NPC_NURSE { return "护士"; }
    if npc_type == NPC_ARMS_DEALER { return "军火商"; }
    if npc_type == NPC_DEMOLITIONIST { return "爆破专家"; }
    if npc_type == NPC_GUIDE { return "向导"; }
    return "未知 NPC";
}

micro add_item_to_inventory(inventory: Inventory, item_id: i32, count: i32) {
    let remaining = count;

    loop i in range(0, inventory.slots) {
        if inventory.item_ids[i] == item_id && inventory.item_counts[i] > 0 {
            let can_add = 99 - inventory.item_counts[i];
            if can_add > 0 {
                let add = min(can_add, remaining);
                inventory.item_counts[i] += add;
                remaining -= add;
                if remaining == 0 {
                    return;
                }
            }
        }
    }

    loop i in range(0, inventory.slots) {
        if inventory.item_ids[i] == ITEM_NONE || inventory.item_counts[i] == 0 {
            inventory.item_ids[i] = item_id;
            let add = min(99, remaining);
            inventory.item_counts[i] = add;
            remaining -= add;
            if remaining == 0 {
                return;
            }
        }
    }
}

micro remove_item_from_inventory(inventory: Inventory, item_id: i32, count: i32) {
    let remaining = count;
    loop i in range(0, inventory.slots) {
        if inventory.item_ids[i] == item_id {
            let remove = min(inventory.item_counts[i], remaining);
            inventory.item_counts[i] -= remove;
            remaining -= remove;
            if inventory.item_counts[i] == 0 {
                inventory.item_ids[i] = ITEM_NONE;
            }
            if remaining == 0 {
                return;
            }
        }
    }
}

micro get_tile_color(tile_id: i32) -> Vec3 {
    let tiles = asset.load<gonArray>("config/tile_colors.gon");
    let tile_list = tiles.get("tiles");
    loop i in range(0, tile_list.length()) {
        let tile = tile_list.get(i);
        if tile.get("id").as_int() == tile_id {
            return Vec3 {
                x: tile.get("r").as_f32(),
                y: tile.get("g").as_f32(),
                z: tile.get("b").as_f32()
            };
        }
    }
    return Vec3 { x: 1.0, y: 0.0, z: 1.0 };
}

micro get_enemy_color(enemy_type: i32) -> Vec3 {
    let tiles = asset.load<gonArray>("config/tile_colors.gon");
    let enemy_list = tiles.get("enemies");
    loop i in range(0, enemy_list.length()) {
        let enemy = enemy_list.get(i);
        if enemy.get("type").as_int() == enemy_type {
            return Vec3 {
                x: enemy.get("r").as_f32(),
                y: enemy.get("g").as_f32(),
                z: enemy.get("b").as_f32()
            };
        }
    }
    return Vec3 { x: 1.0, y: 0.0, z: 0.0 };
}

micro is_evil_biome(biome_id: i32) -> bool {
    if biome_id == BIOME_CORRUPTION { return true; }
    if biome_id == BIOME_CRIMSON { return true; }
    return false;
}

micro is_hardmode_biome(biome_id: i32) -> bool {
    if biome_id == BIOME_HALLOW { return true; }
    if biome_id == BIOME_CORRUPTION { return true; }
    if biome_id == BIOME_CRIMSON { return true; }
    return false;
}
