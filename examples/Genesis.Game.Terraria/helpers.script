    if item_id == ITEM_IRON_PICKAXE { return "铁镐"; }
    if item_id == ITEM_GEL { return "凝胶"; }
    if item_id == ITEM_TORCH { return "火把"; }
    if item_id == ITEM_HEALING_POTION { return "治疗药水"; }
    return "未知";
}

micro get_enemy_name(enemy_type: i32) -> string {
    if enemy_type == ENEMY_SLIME { return "史莱姆"; }
    if enemy_type == ENEMY_ZOMBIE { return "僵尸"; }
    if enemy_type == ENEMY_DEMON_EYE { return "恶魔眼"; }
    return "未知敌人";
}

micro get_enemy_health(enemy_type: i32) -> i32 {
    if enemy_type == ENEMY_SLIME { return SLIME_HEALTH; }
    if enemy_type == ENEMY_ZOMBIE { return ZOMBIE_HEALTH; }
    if enemy_type == ENEMY_DEMON_EYE { return DEMON_EYE_HEALTH; }
    return 10;
}

micro get_enemy_damage(enemy_type: i32) -> i32 {
    if enemy_type == ENEMY_SLIME { return SLIME_DAMAGE; }
    if enemy_type == ENEMY_ZOMBIE { return ZOMBIE_DAMAGE; }
    if enemy_type == ENEMY_DEMON_EYE { return DEMON_EYE_DAMAGE; }
    return 5;
}

micro get_enemy_knockback(enemy_type: i32) -> f32 {
    if enemy_type == ENEMY_SLIME { return SLIME_KNOCKBACK; }
    if enemy_type == ENEMY_ZOMBIE { return ZOMBIE_KNOCKBACK; }
    if enemy_type == ENEMY_DEMON_EYE { return DEMON_EYE_KNOCKBACK; }
    return 0.5;
}

