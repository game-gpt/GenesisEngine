    if item_id == ITEM_SAND { return "沙子"; }
    if item_id == ITEM_IRON_ORE { return "铁矿石"; }
    if item_id == ITEM_GOLD_ORE { return "金矿石"; }
    if item_id == ITEM_COPPER_ORE { return "铜矿石"; }
    if item_id == ITEM_COPPER_BAR { return "铜锭"; }
    if item_id == ITEM_IRON_BAR { return "铁锭"; }
    if item_id == ITEM_GOLD_BAR { return "金锭"; }
    if item_id == ITEM_WOODEN_SWORD { return "木剑"; }
    if item_id == ITEM_WOODEN_PICKAXE { return "木镐"; }
    if item_id == ITEM_COPPER_SWORD { return "铜剑"; }
    if item_id == ITEM_COPPER_PICKAXE { return "铜镐"; }
